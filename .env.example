# QingyiPersonal 环境变量样例（复制为 config.env 后填真实值；config.env 已被 gitignore）
# ── 身份 ──
BOT_SELF_NAME=清漪
BOT_DISPLAY_NAME=清漪
MASTER_QQ_IDS=                 # 主人 QQ（批准账本认这个），逗号分隔
BOT_QQ_UID=                    # bot 自身 QQ（多余账号检测）
AFFECTION_SEED=                # 初始好感 "qq=分值,qq=分值"，留空不预设

# ── QQ 接入 ──
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# ── 模型通道（七组，前缀同规则）──
LLM_TEXT_BASE_URL=
LLM_TEXT_API_KEY=
LLM_TEXT_MODEL=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
LLM_DEEP_BASE_URL=
LLM_DEEP_API_KEY=
LLM_DEEP_MODEL=
LLM_SOL_BASE_URL=
LLM_SOL_API_KEY=
LLM_SOL_MODEL=
LLM_SUMMARY_BASE_URL=
LLM_SUMMARY_API_KEY=
LLM_SUMMARY_MODEL=
LLM_FB1_BASE_URL=
LLM_FB1_API_KEY=
LLM_FB1_MODEL=
LLM_FB2_BASE_URL=
LLM_FB2_API_KEY=
LLM_FB2_MODEL=

# ── 图像 / 语音 ──
FLARE_API_KEY=
FLARE_URL=
FLARE_MODEL=
QWENIMG_API_KEY=
QWENIMG_BASE_URL=
TTS_API_KEY=
TTS_SPEAK_MODEL=qwen3-tts-flash
TTS_SPEAK_VOICE=Cherry
TTS_SING_MODEL=qwen-audio-3.0-tts-flash
TTS_SING_VOICE=longanfengyue
SING_SUNO_ENABLED=0            # 成曲通道默认关，绝不自动调用
ASR_ENABLED=1

# ── 云端智能体 / 检索 ──
QWEN_AGENT_ENABLED=0
QWEN_AGENT_ID=
QWEN_AGENT_BASE=
QWEN_AGENT_API_KEY=
SEARCH_ENABLED=0
SEARCH_API_KEY=

# ── Web 面板 ──
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_SECRET_KEY=                # 随机 32+ 字符
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=            # 自行设置
CEYLAN_OBSERVER_USER=observer
CEYLAN_OBSERVER_HASH=          # scrypt 哈希

# ── 运维通道（本地工具用，服务器上不写真实值）──
OPS_SSH_HOST=
OPS_SSH_USER=root
OPS_SSH_KEY=
OPS_LOCAL_ROOT=

# ── 监控与账单 ──
WATCHDOG_PUBLIC_URL=           # 留空则跳过公网探测
ALIYUN_ACCESS_KEY_ID=          # RAM 只读（账单对账），可留空
ALIYUN_ACCESS_KEY_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ── 数据路径 ──
DATA_DIR=./data
NOVEL_CORPUS_DIR=data/novel_corpus
